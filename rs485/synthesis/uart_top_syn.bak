#add_file options
add_file -verilog "C:/Users/jycao/Desktop/1/code-graduationdesign/rs485/hdl/uart_rx.v"
add_file -verilog "C:/Users/jycao/Desktop/1/code-graduationdesign/rs485/hdl/uart_tx.v"
add_file -verilog "C:/Users/jycao/Desktop/1/code-graduationdesign/rs485/hdl/uart_top.v"



#project files
add_file -ident_constraint "synthesis_1/identify.idc"


#implementation: "synthesis"
impl -add synthesis -type fpga

#
#implementation attributes

set_option -vlog_std v2001

#device options
set_option -technology ProASIC3
set_option -part A3P250
set_option -package VQFP100
set_option -speed_grade STD
#compilation/mapping options
set_option -use_fsm_explorer 0
# hdl_compiler_options
set_option -distributed_compile 0

# mapper_without_write_options
set_option -frequency 100.000
set_option -srs_instrumentation 1

set_option -top_module uart_top

# mapper_options
set_option -write_verilog 0
set_option -write_vhdl 0

# actel_options
set_option -rw_check_on_ram 0

# Microsemi 500K
set_option -run_prop_extract 1
set_option -maxfan 24
set_option -retiming 0
set_option -report_path 4000
set_option -update_models_cp 0
set_option -preserve_registers 0
# Microsemi 500K
set_option -globalthreshold 50

# NFilter
set_option -no_sequential_opt 0

# sequential_optimization_options
set_option -symbolic_fsm_compiler 1

# Compiler Options
set_option -compiler_compatible 0
set_option -resource_sharing 1

# Compiler Options
set_option -auto_infer_blackbox 0
set_option -ident_constraint  ""

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "./uart_top.edn"


#implementation: "synthesis_1"
impl -add synthesis_1 -type fpga

#
#implementation attributes

#par_1 attributes
set_option -job par_1 -add par

set_option -vlog_std v2001

#device options
set_option -technology ProASIC3
set_option -part A3P250
set_option -package VQFP100
set_option -speed_grade STD
#compilation/mapping options
set_option -use_fsm_explorer 0
# hdl_compiler_options
set_option -distributed_compile 0

# mapper_without_write_options
set_option -frequency 100.000
set_option -identify_debug_mode 1
set_option -srs_instrumentation 1

set_option -top_module uart_top

# mapper_options
set_option -write_verilog 0
set_option -write_vhdl 0

# actel_options
set_option -rw_check_on_ram 0

# Microsemi 500K
set_option -run_prop_extract 1
set_option -maxfan 24
set_option -retiming 0
set_option -report_path 4000
set_option -update_models_cp 0
set_option -preserve_registers 0
# Microsemi 500K
set_option -globalthreshold 50

# NFilter
set_option -no_sequential_opt 0

# sequential_optimization_options
set_option -symbolic_fsm_compiler 1

# Compiler Options
set_option -compiler_compatible 0
set_option -resource_sharing 1

# Compiler Options
set_option -auto_infer_blackbox 0

#automatic place and route (vendor) options
set_option -write_apr_constraint 1

#set result format/file last
project -result_file "synthesis_1/uart_top.edn"
impl -active "synthesis_1"
